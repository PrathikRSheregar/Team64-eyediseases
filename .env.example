# ============================================================
# Eye Disease Prediction - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- App ---
ENVIRONMENT=development
DEBUG=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
POSTGRES_USER=eye_user
POSTGRES_PASSWORD=eye_password
POSTGRES_DB=eye_disease_db
# Used directly by the backend when NOT running via docker-compose:
DATABASE_URL=postgresql://eye_user:eye_password@localhost:5432/eye_disease_db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- File storage ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/bmp,image/tiff

# --- ML ---
MODELS_DIR=models
ARTIFACTS_DIR=ml/artifacts
EYE_DATASET_DIR=dataset
EYE_EPOCHS=25
EYE_FINE_TUNE_EPOCHS=10

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=/api
